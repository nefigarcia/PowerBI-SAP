/// SAP Sales Document Item (SAP_SD_RL_SalesDocumentItem_V2)
/// Order intake facts. One row = one sales-order line.
table SalesOrders
	lineageTag: b2220001-0000-4000-a000-000000000001

	measure 'ISO AOP - $/bdft OI' = SUM(SalesOrders[Revenue_Order_Intake])/SUM(SalesOrders[Order_Quantity_in_BFT2])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Production Measures
		lineageTag: 2c0e891a-9b66-42ba-85c8-fd077b6d573c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sum Fcst Order Qty. in FT2 for Membranes OI' =
			
			VAR FcstOrderQtyFT2MembranesOI =
			SUMX(
			    FILTER(
			        SalesOrders,
			        CONTAINSSTRING(SalesOrders[FC_Product_Group], "TPO")
			    ),
			    SalesOrders[ForecastSalesSQFT]
			)
			RETURN
			IF(
			    FcstOrderQtyFT2MembranesOI = BLANK(),
			    0,
			    FcstOrderQtyFT2MembranesOI
			)
		formatString: 0
		displayFolder: Production Measures
		lineageTag: fe74e79c-49c9-45a9-9788-1ad131d3407f

	measure 'Sum Order Qty. in BFT2 for ISO OI' =
			
			VAR OrderQtyBFT2ISOOI =
			SUMX(
			    FILTER(
			        SalesOrders,
			        CONTAINSSTRING(SalesOrders[Product_Family_Product_Number], "iso")
			    ),
			    SalesOrders[Requested_Quantity_in_BFT]
			)
			RETURN
			IF(
			    OrderQtyBFT2ISOOI = BLANK(),
			    0,
			    OrderQtyBFT2ISOOI
			)
		displayFolder: Production Measures
		lineageTag: f9d09aa3-16f6-4caf-9c82-d111bc5827b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sum Order Qty. in BFT2 for ISO SB' =
			
			VAR OrderQtyBFT2ISOSB =
			SUMX(
			    FILTER(
			        SalesOrders,
			        CONTAINSSTRING(SalesOrders[FC_Product_Group], "ISO")
			    ),
			    SalesOrders[Requested_Quantity_in_BFT]
			)
			RETURN
			IF(
			    OrderQtyBFT2ISOSB = BLANK(),
			    0,
			    OrderQtyBFT2ISOSB
			)
		displayFolder: Production Measures
		lineageTag: 67ae59d4-128f-4d3e-9068-1e9397f8403e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sum Order Qty. in FT2 for Membranes OI' =
			
			VAR OrderQtyFT2MembranesOI =
			SUMX(
			    FILTER(
			        SalesOrders,
			        CONTAINSSTRING(SalesOrders[Product_Family_Product_Number], "Membrane")
			    ),
			    SalesOrders[Order_Quantity_in_FT2]
			)
			RETURN
			IF(
			    OrderQtyFT2MembranesOI = BLANK(),
			    0,
			    OrderQtyFT2MembranesOI
			)
		displayFolder: Production Measures
		lineageTag: 269d8b55-af28-4506-bf94-e9d8867a4d23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sum Order Qty. in FT2 for Membranes SB' =
			
			VAR OrderQtyFT2MembranesSB =
			SUMX(
			    FILTER(
			        SalesOrders,
			        CONTAINSSTRING(SalesOrders[FC_Product_Group], "TPO")
			    ),
			    SalesOrders[RequestedQuantityInBaseUnit]
			)
			RETURN
			IF(
			    OrderQtyFT2MembranesSB = BLANK(),
			    0,
			    OrderQtyFT2MembranesSB
			)
		displayFolder: Production Measures
		lineageTag: 5ea235c8-1c76-456c-9ba1-25dd7c616945

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sum Order Qty. in FT2 for Membranes SB 2' =
			
			VAR OrderQtyFT2MembranesSB2 =
			CALCULATE(
			    SUMX(SalesOrders, [Open_Order_Quantity_in_FT2]),
			    SalesOrders[FC_Product_Group] = "TPO"
			)
			RETURN
			IF(
			    OrderQtyFT2MembranesSB2 = BLANK(),
			    0,
			    OrderQtyFT2MembranesSB2
			)
		displayFolder: Production Measures
		lineageTag: 556894fe-9af6-41a1-86b4-c5cfa1fc08de

	measure 'ISO Rate OI' =
			
			VAR IsoRateOI =
			[Sum Order Qty. in BFT2 for ISO OI]/[Sum Order Qty. in FT2 for Membranes OI]
			RETURN
			IF(
			    IsoRateOI = BLANK(),
			    0,
			    IsoRateOI
			)
		displayFolder: Production Measures
		lineageTag: d4b240fa-dccb-4824-98f3-8162af01fffc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ISO Rate SB' =
			
			VAR IsoRateVBAPSB =
			[Sum Order Qty. in BFT2 for ISO SB]/[Sum Order Qty. in FT2 for Membranes SB]
			RETURN
			IF(
			    IsoRateVBAPSB = BLANK(),
			    0,
			    IsoRateVBAPSB
			)
		displayFolder: Production Measures
		lineageTag: 23635400-84c2-4bf1-b056-ab9ed178837e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ISO Rate Fcst OI' =
			
			VAR IsoRateFcstOI =
			DIVIDE(
				SUM(SalesOrders[ForecastSalesBDFT]),
				[Sum Fcst Order Qty. in FT2 for Membranes OI]
			)
			RETURN
			IF(
			    IsoRateFcstOI = BLANK(),
			    0,
			    IsoRateFcstOI
			)
		displayFolder: Production Measures
		lineageTag: 7d6f8a41-9c22-4272-88ec-e6d6fd58c551

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Backlog $' =
			
			VAR TotalBacklog =
			SUM(SalesOrders[Revenue_Backlog])
			RETURN
			IF(TotalBacklog = BLANK(),
			0,
			TotalBacklog)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Production Measures
		lineageTag: 28a120d1-2597-4861-8715-761318820c6d

