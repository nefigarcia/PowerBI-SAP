/// SAP Billing Document Item (SAP_SD_RL_BillingDocumentItem_V2)
/// Invoiced sales facts. One row = one invoice line.
table Billing
	lineageTag: b1110001-0000-4000-a000-000000000001

	measure 'Sum Billing Qty. in FT2 for Membranes' =
			
			VAR BillingQtyFT2Membranes =
			SUMX(
			    FILTER(
			        Billing,
			        CONTAINSSTRING(Billing[FC_Product_Group], "TPO")
			    ),
			    Billing[Billing_Quantity_in_FT2]
			)
			RETURN
			IF(
			    BillingQtyFT2Membranes = BLANK(),
			    0,
			    BillingQtyFT2Membranes
			)
		formatString: #,0
		displayFolder: Production Measures
		lineageTag: f073d35a-0c59-4212-adc8-3718bcf25294

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Sum Billing Qty. in BFT2 for ISO 2' =
			
			VAR BillingQtyBFT2ISO =
			SUMX(
			    FILTER(
			        Billing,
			        CONTAINSSTRING(Billing[FC_Product_Group], "iso")
			    ),
			    Billing[Billing_Quantity_with_Signs]
			)
			RETURN
			IF(
			    BillingQtyBFT2ISO = BLANK(),
			    0,
			    BillingQtyBFT2ISO
			)
		formatString: #,0
		displayFolder: Production Measures
		lineageTag: f2d6f3ed-90c8-4dc5-a77d-ed5a7cae23fe

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Sum Billing Qty. in BFT2 for ISO' =
			
			VAR BillingQtyBFT2ISO =
			SUMX(
			    FILTER(
			        Billing,
			        CONTAINSSTRING(Billing[FC_Product_Group], "iso")
			    ),
			    Billing[Billing_Quantity_in__BFT2]
			)
			RETURN
			IF(
			    BillingQtyBFT2ISO = BLANK(),
			    0,
			    BillingQtyBFT2ISO
			)
		displayFolder: Production Measures
		lineageTag: da3bfc2c-e9ee-48c0-95af-b85ab384da07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sum Fcst Sales in FT2 for Membranes' =
			
			VAR FcstSalesQtyFT2Membranes =
			SUMX(
			    Billing,
			    IFERROR(VALUE(Billing[Sales_Forecast_Membrane_Qty_in_FT2]), 0)
			)
			RETURN
			IF(
			    FcstSalesQtyFT2Membranes = BLANK(),
			    0,
			    FcstSalesQtyFT2Membranes
			)
		formatString: 0
		displayFolder: Production Measures
		lineageTag: cb0804d7-8deb-42de-b009-203850fe7d99

	measure 'Sum Revenue in DC with sign IS' =
			
			VAR RevDcIS =
			SUM(Billing[Revenue])
			RETURN
			IF(
			    RevDcIS = BLANK(),
			    0,
			    RevDcIS
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Production Measures
		lineageTag: 48555e51-6706-4088-b40b-1e2eae25aa8b

	measure 'ISO AOP - $/bdft IS' = SUM(Billing[Revenue])/SUM(Billing[Billing_Quantity_with_Signs])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Production Measures
		lineageTag: c262598f-e8b0-4e7e-a7ae-c372ac3d196f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'ISO Rate IS' =
			
			VAR IsoRateIS =
			[Sum Billing Qty. in BFT2 for ISO]/[Sum Billing Qty. in FT2 for Membranes]
			RETURN
			IF(
			    IsoRateIS = BLANK(),
			    0,
			    IsoRateIS
			)
		displayFolder: Production Measures
		lineageTag: 3a5d4b38-2bd2-4402-bbdf-81ada8ee19e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ISO Rate Fcst IS' =
			
			VAR IsoRateFcstIS =
			DIVIDE(
				SUM(Billing[ForecastSalesBDFT]),
				([Sum Fcst Sales in FT2 for Membranes])
			)
			RETURN
			IF(
			    IsoRateFcstIS = BLANK(),
			    0,
			    IsoRateFcstIS
			)
		displayFolder: Production Measures
		lineageTag: 37d91d36-6ca4-4e61-9891-f254ec7cf54f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Fiscal Period' =
			
			VALUE(
			    MAX(
			        'Fiscal Period Selector'[FiscalYearPeriod]
			    )
			)
		lineageTag: e3c2452f-4b10-4230-983b-92f3f611fd36

