	/// Reformats 'Fiscal Year Period Sorted' (YYYY.PP, e.g. "2026.07") to Billing's SAP format YYYYPPP (e.g. "2026007"), so this table can join to Billing[FiscalYearPeriod] / Fiscal Period Selector[FiscalYearPeriod].
	column 'Fiscal Year Period Billing Format' = LEFT('KRW-NA_FF_FORECAST'[Fiscal Year Period Sorted], 4) & "0" & RIGHT('KRW-NA_FF_FORECAST'[Fiscal Year Period Sorted], 2)
		dataType: string
		lineageTag: 6932c9d6-97bf-40e0-9fc0-461024801009
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

