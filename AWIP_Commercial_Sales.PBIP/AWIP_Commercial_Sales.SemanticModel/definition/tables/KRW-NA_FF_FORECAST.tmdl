table KRW-NA_FF_FORECAST
	lineageTag: 6932c9d6-97bf-40e0-9fc0-4610248ed4fc

	/// Ported from KRW-NA_FF_FORECAST (production). Filters this fact to the current fiscal year-period reported by Billing via helper measure Billing[Current FYP VBRP].
	measure 'Current Month Invoice Revenue Fcst' =
			CALCULATE(
			    SUM('KRW-NA_FF_FORECAST'[Sales $]),
			    FILTER(
			        'KRW-NA_FF_FORECAST',
			        'KRW-NA_FF_FORECAST'[Fiscal Year Period] = [Current FYP VBRP]
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Production Measures
		lineageTag: e0000010-0001-4000-a000-000000000001

	/// Ported from KRW-NA_FF_FORECAST (production).
	measure 'Current Month Invoiced Sales Membrane sqft' =
			CALCULATE(
			    SUM('KRW-NA_FF_FORECAST'[Sales Membrane sqft]),
			    FILTER(
			        'KRW-NA_FF_FORECAST',
			        'KRW-NA_FF_FORECAST'[Fiscal Year Period] = [Current FYP VBRP]
			    )
			)
		formatString: #,0
		displayFolder: Production Measures
		lineageTag: e0000010-0002-4000-a000-000000000002

	/// Ported from KRW-NA_FF_FORECAST (production). YTD filter uses KRW_NA_FF_CALENDAR (no OI-side calendar variant exists in AWIP).
	measure 'YTD Invoiced Sales Membrane sqft' =
			CALCULATE(
			    SUM('KRW-NA_FF_FORECAST'[Sales Membrane sqft]),
			    FILTER(
			        'KRW_NA_FF_CALENDAR',
			        YEAR('KRW_NA_FF_CALENDAR'[Date]) = YEAR(TODAY())
			    )
			)
		formatString: #,0
		displayFolder: Production Measures
		lineageTag: e0000010-0003-4000-a000-000000000003

	/// Ported from KRW-NA_FF_FORECAST (production).
