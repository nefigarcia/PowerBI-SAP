model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["p_DatasphereServer","p_DatasphereSpace","p_SalesOrganization","p_CompanyCode","Billing","SalesOrders","KRW_NA_FF_CALENDAR","CAPEX Approved","KRW_NA_FF_COSTCENTREHIER","KRW_NA_FF_COSTCTHIER_ONDULINE","KRW_NA_FF_COSTELEM_OH1","KRW_NA_FF_COSTELEMHIER","KRW_NA_FF_FISCALPERIOD","KRW_NA_FF_FORECAST_INTAKE","KRW_NA_FF_GEOINFO","KRW_NA_FF_HISTSB1","KRW_NA_FF_PLSTRUCTURE","KRW_NA_FF_TERRITORY","KRW_NA_FF_ZIPCODES"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Billing
ref table DimDate
ref table SalesOrders
ref table _Measures
ref table KRW_NA_FF_CALENDAR
ref table 'CAPEX Approved'
ref table KRW_NA_FF_COSTCENTREHIER
ref table KRW_NA_FF_COSTCTHIER_ONDULINE
