	measure 'Sum Order Qty. in FT2 for Membranes OI' =
			
			VAR OrderQtyFT2MembranesOI =
			SUMX(
			    FILTER(
			        'KRW_NA_SAP_VBAP OI',
			        CONTAINSSTRING('KRW_NA_SAP_VBAP OI'[Product Family], "Membrane")
			    ),
			    'KRW_NA_SAP_VBAP OI'[Order Qty. in FT2]
			)
			RETURN
			IF(
			    OrderQtyFT2MembranesOI = BLANK(),
			    0,
			    OrderQtyFT2MembranesOI
