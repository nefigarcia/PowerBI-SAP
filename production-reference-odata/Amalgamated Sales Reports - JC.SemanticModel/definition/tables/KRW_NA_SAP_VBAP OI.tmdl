	measure 'Margin Perc VBAP' =
			
			DIVIDE(
				SUM('KRW_NA_SAP_VBAP OI'[Margin in DC]),
				SUM('KRW_NA_SAP_VBAP OI'[Revenue in DC with Sign])
			)
		formatString: 0.0%;-0.0%;0.0%
