table KRW-NA_FF_FORECAST
	lineageTag: 8018f2e9-856c-4e98-9a0d-3ac2b3850c07
	sourceLineageTag: 4bccaca2-49b3-4aba-9014-e955e9567bf3

	measure 'ISO Rate Fcst' =
			
			VAR IsoRateFcst =
			DIVIDE(
				SUM('KRW-NA_FF_FORECAST'[Sales ISO bdft]),
				SUM('KRW-NA_FF_FORECAST'[Sales Membrane sqft])
			)
			RETURN
			IF(
			    IsoRateFcst = BLANK(),
			    0,
			    IsoRateFcst
			)
		formatString: #,0.00
		lineageTag: 389772dd-01a6-4345-93d9-05db59d094c2

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

		changedProperty = Name

	measure 'Current Month Invoice Revenue Fcst' =
			
			CALCULATE(
			SUM('KRW-NA_FF_FORECAST'[Sales $]),
			FILTER(
			'KRW-NA_FF_FORECAST',
			'KRW-NA_FF_FORECAST'[Fiscal Year Period] = [Current FYP VBRP]
			)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0c1893cc-588b-43da-8f6a-9231eb973885

		changedProperty = Name

		changedProperty = FormatString

	measure 'Current Month Invoiced Sales Membrane sqft' =
			
			CALCULATE(
			SUM('KRW-NA_FF_FORECAST'[Sales Membrane sqft]),
			FILTER(
			'KRW-NA_FF_FORECAST',
			'KRW-NA_FF_FORECAST'[Fiscal Year Period] = [Current FYP VBRP]
			)
			)
		formatString: #,0
		lineageTag: dd4a4386-e4f2-4a68-9422-5a6324379fa9

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'YTD Invoiced Sales Membrane sqft' =
			
			CALCULATE(
			SUM('KRW-NA_FF_FORECAST'[Sales Membrane sqft]),
			FILTER(
			'KRW_NA_FF_CALENDAR',
			YEAR('KRW_NA_FF_CALENDAR'[Date]) = YEAR(TODAY())
			)
			)
		formatString: #,0
		lineageTag: ecde9692-ad21-44ad-8805-750485382c57

		changedProperty = Name

