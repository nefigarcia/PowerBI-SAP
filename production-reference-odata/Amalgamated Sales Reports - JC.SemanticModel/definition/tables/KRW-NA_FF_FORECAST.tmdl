			    'KRW-NA_FF_FORECAST'[Sales Membrane sqft] = 0,
			    0,
			    'KRW-NA_FF_FORECAST'[Sales ISO bdft]/'KRW-NA_FF_FORECAST'[Sales Membrane sqft]
			)
